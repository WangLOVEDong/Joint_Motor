{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "STM32: 只烧录 Joint_Motor (不编译)",
            "type": "process",
            "command": "${env:LOCALAPPDATA}/stm32cube/bundles/programmer/2.23.0/bin/STM32_Programmer_CLI.exe",
            "args": [
                "-c", "port=SWD", "freq=1000",
                "-w", "${workspaceFolder}/build/Debug/Joint_Motor.elf",
                "-v", "-rst"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        }
    ]
}
